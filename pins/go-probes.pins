# arthron edge pins — the target-stability gate.
#
# Regenerate this file with ONE command, from the repository root:
#
#   arthron pin corpus/go/probes --pins pins/go-probes.pins --write --commit 4ed8b2c1c974afafc255df3390543931cea3b938
#
# Nothing else writes this file and nothing hand-edits it. A pin file edited
# by hand is a claim about a scan that never ran.
#
# What it is. One line per resolved reference row, grouped under the file the
# reference sits in: the row's 64-bit key hash, and an index into the [targets]
# dictionary above it. The key hashed is the store's own canonical row key —
# kind, declaration space, enclosing FQN, site text, arity, file-local argument
# types, binding verdict — so a row's identity here is the row's identity there.
#
# What it is for. `arthron gate` compares four integers, and a reference that
# resolves to the *wrong* definition moves none of them: it is still one
# resolved row and still one edge, and only the far end changed. This file is
# the only thing in the build that reads the far end.
#
# How it fails. A pinned row whose target changed fails by name —
# `target_moved` — printing the file, the line, the site text, the old target
# and the new one. A row that appeared is coverage growth and passes. A row
# that vanished with nothing in its place is flagged, not failed: the counting
# gate owns that half, and a re-pin that drops rows shows the drop as deleted
# lines in this file's diff. A row that vanished *while another appeared* is a
# row whose key changed, and that fails by name too — `rows_rekeyed` — because
# re-keying preserves all four of the integers `arthron gate` compares by
# construction, so nothing else in the build would ever say the row stopped
# being checked.
#
# Re-pinning is a deliberate act. Every changed target is a claim that the old
# edge was wrong, and belongs in docs/decisions.md with the reason.
#
# `corpus` and `commit` are provenance: printed, never verified.
# `targets` and `rows` are not a second copy of the body — they are a checksum
# over it, and a file whose header disagrees with its own sections is refused
# rather than read.
format = 1
corpus = "corpus/go/probes"
commit = "4ed8b2c1c974afafc255df3390543931cea3b938"
targets = 14
rows = 17

[targets]
def example.com/arthron/probes/clauseheader#Producer
def example.com/arthron/probes/dotted/p#Foo
def example.com/arthron/probes/dotted/p.Foo#Bar
def example.com/arthron/probes/pkgrename/alpha#Name
def example.com/arthron/probes/pkgrename/beta#Name
def example.com/arthron/probes/shadowpair#Emit
def example.com/arthron/probes/testpkg/api#Serve
def example.com/arthron/probes/testpkg/api_test#Serve
pkg example.com/arthron/probes/dotted/p
pkg example.com/arthron/probes/dotted/p.Foo
pkg example.com/arthron/probes/pkgrename/alpha
pkg example.com/arthron/probes/pkgrename/beta
pkg example.com/arthron/probes/testpkg/api
pkg example.com/arthron/probes/testpkg/api_test

